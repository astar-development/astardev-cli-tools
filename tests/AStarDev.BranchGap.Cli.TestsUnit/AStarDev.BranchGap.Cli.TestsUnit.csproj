<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <NoWarn>$(NoWarn);IDE1006;</NoWarn>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Shouldly" Version="1.0.1.60" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AStarDev.BranchGap.Cli\AStarDev.BranchGap.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\AStarDev.BranchGap.Coverage.Cobertura.TestsUnit\TestData\RealCoverage.xml" Link="TestData\RealCoverage.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
